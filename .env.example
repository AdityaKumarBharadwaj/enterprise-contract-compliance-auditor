# AWS Credentials & Bedrock Configuration
# You can fill these in, or run standard AWS SSO / IAM credentials

AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Once created in AWS Bedrock Console, paste your Knowledge Base ID here:
BEDROCK_KB_ID=your_kb_id_here
